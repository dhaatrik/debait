{
  "manifest_version": 3,
  "name": "DeBait — Honest YouTube Thumbnails",
  "version": "1.1.1",
  "description": "DeBait replaces clickbait YouTube thumbnails with genuine frames from halfway through the video. Toggle between them anytime with 1 click.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DeBait",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-thumbnails": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "DeBait: Toggle between halfway frames and creator thumbnails"
    }
  }
}
